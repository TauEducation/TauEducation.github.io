{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tau.education/schemas/content.json",
  "title": "tau.education content files",
  "description": "One schema per page, selected via $defs. Validate home.json against #/$defs/home, course-*.json against #/$defs/course, labs.json against #/$defs/labs, notfound.json against #/$defs/notfound. String lengths are layout limits, not style advice.",
  "$defs": {
    "plain": {
      "type": "string",
      "pattern": "^[^<>*#`|]*$"
    },
    "num2": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "explorationView": {
      "enum": [
        "table",
        "plot",
        "number-line",
        "diagram"
      ]
    },
    "explorationPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,12}$"
        },
        "label": {
          "$ref": "#/$defs/plain",
          "minLength": 1,
          "maxLength": 28
        },
        "value": {
          "type": "number"
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/plain",
          "minLength": 12,
          "maxLength": 28
        },
        "href": {
          "type": "string",
          "pattern": "^(/|mailto:|https://)"
        }
      }
    },
    "keyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/plain",
          "minLength": 6,
          "maxLength": 22
        },
        "value": {
          "$ref": "#/$defs/plain",
          "minLength": 14,
          "maxLength": 90
        }
      }
    },
    "sparkline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "shape"
      ],
      "properties": {
        "kind": {
          "const": "sparkline"
        },
        "shape": {
          "enum": [
            "sir-bump",
            "noisy-vs-smooth",
            "inverse-sqrt",
            "monotone-decay",
            "trending-residuals",
            "oscillation-damped"
          ]
        },
        "second": {
          "enum": [
            "noisy",
            null
          ]
        }
      }
    },
    "xyFit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "caption",
        "figLabel",
        "x",
        "y",
        "observed",
        "model",
        "metrics"
      ],
      "properties": {
        "kind": {
          "const": "xy-fit"
        },
        "caption": {
          "$ref": "#/$defs/plain",
          "minLength": 20,
          "maxLength": 60
        },
        "figLabel": {
          "$ref": "#/$defs/plain",
          "minLength": 4,
          "maxLength": 12
        },
        "x": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "min",
            "max"
          ],
          "properties": {
            "label": {
              "$ref": "#/$defs/plain",
              "minLength": 1,
              "maxLength": 24
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "y": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "min",
            "max",
            "ticks"
          ],
          "properties": {
            "label": {
              "$ref": "#/$defs/plain",
              "minLength": 1,
              "maxLength": 24
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "ticks": {
              "type": "array",
              "minItems": 4,
              "maxItems": 6,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "observed": {
          "type": "array",
          "minItems": 10,
          "maxItems": 16,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expression",
            "params"
          ],
          "properties": {
            "expression": {
              "type": "string",
              "minLength": 4,
              "maxLength": 60
            },
            "params": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/plain",
            "minLength": 8,
            "maxLength": 26
          }
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hero",
        "pillars",
        "exploration",
        "notebook",
        "areas",
        "spaces",
        "footer"
      ],
      "properties": {
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrowBrand",
            "eyebrowNote",
            "title",
            "lede",
            "ctas"
          ],
          "properties": {
            "eyebrowBrand": {
              "$ref": "#/$defs/plain",
              "minLength": 3,
              "maxLength": 20
            },
            "eyebrowNote": {
              "$ref": "#/$defs/plain",
              "minLength": 10,
              "maxLength": 36
            },
            "title": {
              "$ref": "#/$defs/plain",
              "minLength": 38,
              "maxLength": 72
            },
            "lede": {
              "$ref": "#/$defs/plain",
              "minLength": 170,
              "maxLength": 260
            },
            "ctas": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/cta"
              }
            }
          }
        },
        "pillars": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "title",
              "desc"
            ],
            "properties": {
              "n": {
                "$ref": "#/$defs/num2"
              },
              "title": {
                "$ref": "#/$defs/plain",
                "minLength": 6,
                "maxLength": 14
              },
              "desc": {
                "$ref": "#/$defs/plain",
                "minLength": 24,
                "maxLength": 52
              }
            }
          }
        },
        "exploration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "title",
            "lede",
            "question",
            "context",
            "known",
            "figure",
            "initial",
            "tension",
            "reframed",
            "formalization",
            "decision",
            "validation",
            "transfer"
          ],
          "properties": {
            "demo": {
              "type": "boolean",
              "description": "true marks the whole block as placeholder content that must not ship."
            },
            "eyebrow": {
              "$ref": "#/$defs/plain",
              "minLength": 8,
              "maxLength": 32
            },
            "title": {
              "$ref": "#/$defs/plain",
              "minLength": 30,
              "maxLength": 110
            },
            "lede": {
              "$ref": "#/$defs/plain",
              "minLength": 90,
              "maxLength": 240
            },
            "question": {
              "$ref": "#/$defs/plain",
              "minLength": 20,
              "maxLength": 130
            },
            "context": {
              "$ref": "#/$defs/plain",
              "minLength": 40,
              "maxLength": 240
            },
            "known": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "value"
                ],
                "properties": {
                  "label": {
                    "$ref": "#/$defs/plain",
                    "minLength": 1,
                    "maxLength": 28
                  },
                  "value": {
                    "$ref": "#/$defs/plain",
                    "minLength": 1,
                    "maxLength": 16
                  }
                }
              }
            },
            "figure": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "axis",
                "points"
              ],
              "properties": {
                "axis": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "min",
                    "max",
                    "ticks"
                  ],
                  "properties": {
                    "label": {
                      "$ref": "#/$defs/plain",
                      "minLength": 1,
                      "maxLength": 24
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "ticks": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 7,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "points": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 6,
                  "items": {
                    "$ref": "#/$defs/explorationPoint"
                  }
                },
                "center": {
                  "type": "number"
                },
                "cluster": {
                  "type": "array",
                  "maxItems": 6,
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "initial": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "description",
                "view",
                "preserves",
                "hides"
              ],
              "properties": {
                "title": {
                  "$ref": "#/$defs/plain",
                  "minLength": 4,
                  "maxLength": 40
                },
                "description": {
                  "$ref": "#/$defs/plain",
                  "minLength": 40,
                  "maxLength": 220
                },
                "view": {
                  "$ref": "#/$defs/explorationView"
                },
                "preserves": {
                  "$ref": "#/$defs/plain",
                  "minLength": 15,
                  "maxLength": 130
                },
                "hides": {
                  "$ref": "#/$defs/plain",
                  "minLength": 15,
                  "maxLength": 130
                }
              }
            },
            "tension": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "body",
                "question"
              ],
              "properties": {
                "title": {
                  "$ref": "#/$defs/plain",
                  "minLength": 6,
                  "maxLength": 48
                },
                "body": {
                  "$ref": "#/$defs/plain",
                  "minLength": 40,
                  "maxLength": 240
                },
                "question": {
                  "$ref": "#/$defs/plain",
                  "minLength": 12,
                  "maxLength": 100
                }
              }
            },
            "reframed": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "description",
                "view",
                "invariant",
                "reveals"
              ],
              "properties": {
                "title": {
                  "$ref": "#/$defs/plain",
                  "minLength": 4,
                  "maxLength": 40
                },
                "description": {
                  "$ref": "#/$defs/plain",
                  "minLength": 40,
                  "maxLength": 220
                },
                "view": {
                  "$ref": "#/$defs/explorationView"
                },
                "invariant": {
                  "$ref": "#/$defs/plain",
                  "minLength": 15,
                  "maxLength": 130
                },
                "reveals": {
                  "$ref": "#/$defs/plain",
                  "minLength": 15,
                  "maxLength": 130
                }
              }
            },
            "formalization": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "equation",
                "interpretation"
              ],
              "properties": {
                "equation": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 140
                },
                "interpretation": {
                  "$ref": "#/$defs/plain",
                  "minLength": 40,
                  "maxLength": 260
                }
              }
            },
            "decision": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question",
                "kind",
                "feedback"
              ],
              "properties": {
                "question": {
                  "$ref": "#/$defs/plain",
                  "minLength": 12,
                  "maxLength": 110
                },
                "kind": {
                  "enum": [
                    "choice",
                    "toggle",
                    "slider",
                    "comparison"
                  ]
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "label"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,12}$"
                      },
                      "label": {
                        "$ref": "#/$defs/plain",
                        "minLength": 2,
                        "maxLength": 90
                      },
                      "correct": {
                        "type": "boolean"
                      },
                      "note": {
                        "$ref": "#/$defs/plain",
                        "minLength": 10,
                        "maxLength": 180
                      },
                      "mark": {
                        "type": "number",
                        "description": "optional: a value on figure.axis to highlight when this option is chosen"
                      }
                    }
                  }
                },
                "slider": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max",
                    "step",
                    "target",
                    "tolerance"
                  ],
                  "properties": {
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "step": {
                      "type": "number"
                    },
                    "target": {
                      "type": "number"
                    },
                    "tolerance": {
                      "type": "number"
                    },
                    "unit": {
                      "$ref": "#/$defs/plain",
                      "maxLength": 12
                    },
                    "hint": {
                      "$ref": "#/$defs/plain",
                      "minLength": 8,
                      "maxLength": 90
                    }
                  }
                },
                "feedback": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "correct",
                    "incorrect"
                  ],
                  "properties": {
                    "correct": {
                      "$ref": "#/$defs/plain",
                      "minLength": 20,
                      "maxLength": 240
                    },
                    "incorrect": {
                      "$ref": "#/$defs/plain",
                      "minLength": 20,
                      "maxLength": 240
                    }
                  }
                }
              }
            },
            "validation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "checks"
              ],
              "properties": {
                "title": {
                  "$ref": "#/$defs/plain",
                  "minLength": 6,
                  "maxLength": 40
                },
                "checks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "$ref": "#/$defs/plain",
                        "minLength": 12,
                        "maxLength": 130
                      },
                      "passOption": {
                        "type": "string"
                      },
                      "detail": {
                        "$ref": "#/$defs/plain",
                        "minLength": 10,
                        "maxLength": 180
                      }
                    }
                  }
                }
              }
            },
            "transfer": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "operation"
                ],
                "properties": {
                  "field": {
                    "$ref": "#/$defs/plain",
                    "minLength": 3,
                    "maxLength": 24
                  },
                  "operation": {
                    "$ref": "#/$defs/plain",
                    "minLength": 20,
                    "maxLength": 130
                  }
                }
              }
            }
          }
        },
        "notebook": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "sectionTitle",
            "sectionLede",
            "filename",
            "badge",
            "cells"
          ],
          "properties": {
            "eyebrow": {
              "$ref": "#/$defs/plain",
              "minLength": 10,
              "maxLength": 30
            },
            "sectionTitle": {
              "$ref": "#/$defs/plain",
              "minLength": 28,
              "maxLength": 60
            },
            "sectionLede": {
              "$ref": "#/$defs/plain",
              "minLength": 150,
              "maxLength": 260
            },
            "filename": {
              "type": "string",
              "pattern": "^[a-z0-9_]+\\.ipynb$",
              "maxLength": 34
            },
            "badge": {
              "$ref": "#/$defs/plain",
              "minLength": 10,
              "maxLength": 28
            },
            "cells": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "prompt",
                "math",
                "callouts",
                "code",
                "output",
                "closing"
              ],
              "properties": {
                "prompt": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "body"
                  ],
                  "properties": {
                    "title": {
                      "$ref": "#/$defs/plain",
                      "minLength": 20,
                      "maxLength": 48
                    },
                    "body": {
                      "$ref": "#/$defs/plain",
                      "minLength": 180,
                      "maxLength": 300
                    }
                  }
                },
                "math": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "display"
                  ],
                  "properties": {
                    "display": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 2,
                      "items": {
                        "type": "string",
                        "minLength": 6,
                        "maxLength": 60
                      }
                    }
                  }
                },
                "callouts": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "body"
                    ],
                    "properties": {
                      "label": {
                        "$ref": "#/$defs/plain",
                        "minLength": 6,
                        "maxLength": 24
                      },
                      "body": {
                        "$ref": "#/$defs/plain",
                        "minLength": 80,
                        "maxLength": 160
                      }
                    }
                  }
                },
                "code": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "language",
                    "source",
                    "labelClosed",
                    "labelOpen",
                    "reassurance"
                  ],
                  "properties": {
                    "language": {
                      "const": "python"
                    },
                    "source": {
                      "type": "string",
                      "minLength": 40,
                      "maxLength": 700
                    },
                    "labelClosed": {
                      "$ref": "#/$defs/plain",
                      "minLength": 12,
                      "maxLength": 24
                    },
                    "labelOpen": {
                      "$ref": "#/$defs/plain",
                      "minLength": 12,
                      "maxLength": 24
                    },
                    "reassurance": {
                      "$ref": "#/$defs/plain",
                      "minLength": 30,
                      "maxLength": 60
                    }
                  }
                },
                "output": {
                  "$ref": "#/$defs/xyFit"
                },
                "closing": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "body",
                    "transfers"
                  ],
                  "properties": {
                    "label": {
                      "$ref": "#/$defs/plain",
                      "minLength": 20,
                      "maxLength": 44
                    },
                    "body": {
                      "$ref": "#/$defs/plain",
                      "minLength": 160,
                      "maxLength": 280
                    },
                    "transfers": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "field",
                          "what",
                          "question"
                        ],
                        "properties": {
                          "field": {
                            "$ref": "#/$defs/plain",
                            "minLength": 5,
                            "maxLength": 18
                          },
                          "what": {
                            "$ref": "#/$defs/plain",
                            "minLength": 14,
                            "maxLength": 36
                          },
                          "question": {
                            "$ref": "#/$defs/plain",
                            "minLength": 14,
                            "maxLength": 34
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "areas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "title",
            "lede",
            "rows"
          ],
          "properties": {
            "eyebrow": {
              "$ref": "#/$defs/plain",
              "minLength": 8,
              "maxLength": 26
            },
            "title": {
              "$ref": "#/$defs/plain",
              "minLength": 30,
              "maxLength": 64
            },
            "lede": {
              "$ref": "#/$defs/plain",
              "minLength": 120,
              "maxLength": 200
            },
            "rows": {
              "type": "array",
              "minItems": 4,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "n",
                  "title",
                  "desc"
                ],
                "properties": {
                  "n": {
                    "$ref": "#/$defs/num2"
                  },
                  "title": {
                    "$ref": "#/$defs/plain",
                    "minLength": 8,
                    "maxLength": 28
                  },
                  "desc": {
                    "$ref": "#/$defs/plain",
                    "minLength": 40,
                    "maxLength": 80
                  }
                }
              }
            }
          }
        },
        "spaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "title",
            "cards"
          ],
          "properties": {
            "eyebrow": {
              "$ref": "#/$defs/plain",
              "minLength": 8,
              "maxLength": 26
            },
            "title": {
              "$ref": "#/$defs/plain",
              "minLength": 30,
              "maxLength": 70
            },
            "cards": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kicker",
                  "kickerRight",
                  "title",
                  "body",
                  "chips",
                  "cta",
                  "href",
                  "accent"
                ],
                "properties": {
                  "kicker": {
                    "$ref": "#/$defs/plain",
                    "minLength": 6,
                    "maxLength": 18
                  },
                  "kickerRight": {
                    "$ref": "#/$defs/plain",
                    "minLength": 6,
                    "maxLength": 16
                  },
                  "title": {
                    "$ref": "#/$defs/plain",
                    "minLength": 30,
                    "maxLength": 56
                  },
                  "body": {
                    "$ref": "#/$defs/plain",
                    "minLength": 120,
                    "maxLength": 200
                  },
                  "chips": {
