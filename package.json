{
  "name": "tau-education-site",
  "version": "2.0.0",
  "private": true,
  "description": "tau.education — static site generator (build-time KaTeX + inline SVG figures, no client math)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate:content": "node scripts/build.mjs --validate-only",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "katex": "^0.16.11"
  }
}
